{
  "name": "inspire-network-baseball-cards",
  "private": true,
  "workspaces": [
    "frontend",
    "sanitycms"
  ],
  "scripts": {
    "dev:frontend": "npm run --workspace=frontend dev",
    "dev:sanitycms": "npm run --workspace=sanitycms dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:sanitycms\"",
    "build:frontend": "npm run --workspace=frontend build",
    "build:sanitycms": "npm run --workspace=sanitycms build",
    "deploy:sanitycms": "npm run --workspace=sanitycms deploy",
    "lint:frontend": "npm run --workspace=frontend lint",
    "lint:sanitycms": "npm run --workspace=sanitycms lint",
    "lint": "npm run lint:frontend && npm run lint:sanitycms"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "rxjs": "^7.8.2"
  },
  "dependencies": {
    "@flags-sdk/statsig": "^0.2.2",
    "@sanity/uuid": "^3.0.2",
    "@statsig/react-bindings": "^3.25.3",
    "cmdk": "^1.1.1",
    "flags": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
