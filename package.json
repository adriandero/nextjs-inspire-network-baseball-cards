{
  "name": "inspire-network-baseball-cards",
  "private": true,
  "workspaces": [
    "nextapp",
    "sanitycms"
  ],
  "scripts": {
    "dev:nextapp": "npm run --workspace=nextapp dev",
    "dev:sanitycms": "npm run --workspace=sanitycms dev",
    "dev": "concurrently \"npm run dev:nextapp\" \"npm run dev:sanitycms\"",
    "build:nextapp": "npm run --workspace=nextapp build",
    "build:sanitycms": "npm run --workspace=sanitycms build",
    "deploy:sanitycms": "npm run --workspace=sanitycms deploy",
    "lint:nextapp": "npm run --workspace=nextapp lint",
    "lint:sanitycms": "npm run --workspace=sanitycms lint",
    "lint": "npm run lint:nextapp && npm run lint:sanitycms"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": "22.x"
  }
}

