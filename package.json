{
    "name": "inspire-network-baseball-cards",
    "private": true,
    "workspaces": [
        "frontend",
        "sanitycms"
    ],
    "scripts": {
        "dev:frontend": "npm run --workspace=frontend dev",
        "dev:sanitycms": "npm run --workspace=sanitycms dev",
        "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:sanitycms\"",
        "build:frontend": "npm run --workspace=frontend build",
        "build:sanitycms": "npm run --workspace=sanitycms build",
        "deploy:sanitycms": "npm run --workspace=sanitycms deploy"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "rxjs": "^7.8.2"
    }
}
