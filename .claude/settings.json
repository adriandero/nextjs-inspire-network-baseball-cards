{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint:nextapp)",
      "Bash(npm run lint --workspace=nextapp)",
      "Bash(npm run test:integration --workspace=nextapp)",
      "Bash(npm run build:nextapp)",
      "Bash(node --import tsx --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Bash(npm run deploy:sanitycms:*)",
      "Bash(npx sanity deploy:*)",
      "Bash(npx sanity graphql deploy:*)",
      "Bash(vercel --prod:*)"
    ]
  }
}
